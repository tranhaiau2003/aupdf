{
  "name": "pdf-prepress-studio",
  "version": "1.0.3",
  "description": "Desktop PDF Viewer & Imposition Tool for Prepress",
  "main": "out/main/index.js",
  "author": "Prepress Solutions",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tranhaiau2003/aupdf.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:main && npm run build:preload",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc src/preload/index.ts --outDir out/preload --module CommonJS --target ES2022 --esModuleInterop --skipLibCheck --resolveJsonModule --moduleResolution Node",
    "preview": "vite preview",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "caniuse-lite": "^1.0.30001809",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.9.3",
    "vite": "^6.0.1"
  }
}
