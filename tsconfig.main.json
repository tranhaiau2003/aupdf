{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "outDir": "out/main",
    "rootDir": "src/main",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false
  },
  "include": ["src/main/**/*"],
  "exclude": ["node_modules", "out"]
}
